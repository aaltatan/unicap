SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL (default engine)
DB_ENGINE=django.db.backends.mysql
DB_NAME=unicap
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# or a local SQLite file:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# True: assets from `npm run dev`; False: the build in unicap/static/dist/ (`npm run build`,
# then restart Django: django-vite reads the manifest once)
VITE_DEV_MODE=True
CORS_ALLOWED_ORIGINS=
# PDF reports are the Word reports converted by LibreOffice: its `soffice` program, when it
# is not on the PATH (on Windows without LibreOffice, Microsoft Word is used instead)
SOFFICE_PATH=
# where the backups are kept (default: unicap/private/): a folder the web server does not serve
# PRIVATE_MEDIA_ROOT=
# `uv run manage.py createsuperuser --noinput` reads these
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
